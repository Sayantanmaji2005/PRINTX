# Environment & App Configuration
NODE_ENV=development
APP_MODE=development
PORT=4000
API_URL=http://localhost:4000
CUSTOMER_WEB_URL=http://localhost:3000
SHOP_ADMIN_URL=http://localhost:3001

# PostgreSQL Database (Prisma)
DATABASE_URL="postgresql://printx_user:printx_password@localhost:5432/printx_db?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL="redis://localhost:6379"

# JWT Authentication
JWT_SECRET=printx_jwt_super_secret_access_key_2026_dev_mode
JWT_EXPIRATION=1d
JWT_REFRESH_SECRET=printx_jwt_super_secret_refresh_key_2026_dev_mode
JWT_REFRESH_EXPIRATION=7d

# File Storage (S3 / R2 / Local Disk Fallback)
STORAGE_PROVIDER=local
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=printx-documents
STORAGE_REGION=auto
LOCAL_STORAGE_DIR="./uploads"

# Payment Gateway (Demo / Razorpay / Cashfree / PhonePe)
PAYMENT_PROVIDER=demo
PAYMENT_KEY_ID=rzp_test_printx_demo_key
PAYMENT_KEY_SECRET=rzp_test_printx_demo_secret
PAYMENT_WEBHOOK_SECRET=rzp_test_webhook_secret

# Google Drive Integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Print Agent Secret Token (For shop printer agent authentication)
AGENT_AUTH_SECRET=printx_agent_secure_token_secret_2026

# Next.js Public Vars
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_WS_URL=ws://localhost:4000
